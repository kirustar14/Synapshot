# Copy to .env. Every mock switch defaults to ON when the matching key is missing, so the
# whole system runs with this file empty. Nothing here is a secret, every value is blank.
#
# .env is in .gitignore and has never been committed. Keep it that way.

# ---------------------------------------------------------------- the call

# web is the default: the patient opens a link on their own phone and the page measures
# them. facetime keeps the old Mac rig path alive, which needs OBS, BlackHole and a
# second device.
CALL_MODE=web

# The https URL the texted link points at. An iPhone will not open the camera over plain
# http, so a localhost link cannot work on a phone. Run `make tunnel` for the exact steps.
# No trailing slash.
PUBLIC_URL=

# Only these numbers can ever be texted in live mode. Comma separated, E.164. Put a
# number here only if that person has agreed to be texted.
DEMO_PHONES=

# 1 keeps the uploaded task recordings on disk after the features are taken out of them.
# Off by default: the audio is deleted as soon as it has been measured.
KEEP_AUDIO=0

# ---------------------------------------------------------------- mock switches

# 1 is mock, 0 is real. Leave unset to let the key decide.
MOCK_RIG=1
MOCK_LLM=1
MOCK_PHOTON=1
MOCK_TWILIO=1
MOCK_ELEVEN=1

# Reach features on by default.
REACH=1

# Give each signal its own damage level from the regions that drive it, instead of one
# global number. Off by default, see DECISIONS.md.
REGIONAL_LOADINGS=0

# A conversational agent that answers general questions after the script ends. Off by
# default and never on the safety or measurement path.
LIVE_AGENT=0

# Speech to text backend: whisper runs locally, elevenlabs calls the API.
ASR=whisper

# Optional upgrade for twin/surrogate.py. Needs the sbi package.
USE_SBI=0

# 0 uses the real Schaefer atlas, the real HCP connectivity, the real Allen gene map and
# the real fsaverage5 surface. 1 skips every loader that could touch the network.
OFFLINE=0

# ---------------------------------------------------------------- keys

# Gemini, for natural phrasing and the summaries. Setting the key flips MOCK_LLM to 0.
# Called over plain REST, no extra package.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ElevenLabs. The voice lines, the optional speech to text backend, and the clinic call.
# ELEVENLABS_VOICE_ID must be a voice your account can actually use: a free plan cannot
# use a library voice through the API, and `make voices` will tell you which id to put
# here if the configured one does not work.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_TTS_MODEL=eleven_multilingual_v2
ELEVENLABS_STT_MODEL=scribe_v1
# The outbound clinic call through the conversational agent, instead of Twilio.
ELEVENLABS_AGENT_ID=
ELEVENLABS_PHONE_NUMBER_ID=

# Photon iMessage. Setting both flips MOCK_PHOTON to 0. The send itself happens in
# backend/comms/node, so run `make imessage` once to install the two SDKs.
PHOTON_PROJECT_ID=
PHOTON_PROJECT_SECRET=

# Twilio: the SMS fallback and the clinic call. Setting all three flips MOCK_TWILIO to 0.
# A trial account can only reach numbers it has verified first.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
CLINIC_NUMBER=

# Placing a real phone call needs saying so out loud. Having the ElevenLabs or Twilio
# credentials in this file is NOT permission to ring anyone: without this set to 1 the
# clinic call is written to the event log and never dialled. The number must also be on
# DEMO_PHONES. Alert rules can fire a lot of calls, so turn this on deliberately and
# turn it off again afterwards.
LIVE_CLINIC_CALL=0

# ---------------------------------------------------------------- the legacy rig

# Setting RIG_FACETIME_NUMBER flips MOCK_RIG to 0. Only used with CALL_MODE=facetime.
RIG_FACETIME_NUMBER=
MIC_DEVICE=BlackHole 2ch
SPK_DEVICE=BlackHole 16ch
CAPTURE_FPS=30

# ---------------------------------------------------------------- geometry and paths

# Phone screen and viewing distance, used to turn normalized gaze into degrees.
SCREEN_W_MM=71.5
SCREEN_H_MM=147.0
VIEW_DIST_MM=300

DB_PATH=data/unnamed.db
DATA_DIR=data
API_BASE=http://localhost:8000

# ---------------------------------------------------------------- Sentry

# Errors, tracing, profiling and logs for the backend. Blank keeps Sentry off. Call
# tokens are masked before anything is sent. The frontend DSN goes in web/.env.local as
# VITE_SENTRY_DSN, because Vite only reads env files from web/.
SENTRY_DSN=
SENTRY_ENV=
