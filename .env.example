# Copy to .env. Every mock switch defaults to ON when the matching key is missing,
# so the whole system runs with this file empty.

# Mock switches. 1 is mock, 0 is real. Leave unset to let the key decide.
MOCK_RIG=1
MOCK_LLM=1
MOCK_PHOTON=1
MOCK_TWILIO=1

# Reach features on by default.
REACH=1

# Optional upgrade for twin/surrogate.py. Needs the sbi package.
USE_SBI=0

# 1 skips any template loader that would download an atlas, so startup never waits on wifi.
OFFLINE=1

# LLM. Setting ANTHROPIC_API_KEY flips MOCK_LLM to 0 unless you pin it.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

# Photon iMessage agent. Setting PHOTON_API_KEY flips MOCK_PHOTON to 0.
PHOTON_API_KEY=
PHOTON_BASE_URL=

# Twilio clinic call. Setting all three flips MOCK_TWILIO to 0.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
CLINIC_NUMBER=

# Rig. Setting RIG_FACETIME_NUMBER flips MOCK_RIG to 0.
RIG_FACETIME_NUMBER=
MIC_DEVICE=BlackHole 2ch
SPK_DEVICE=BlackHole 16ch
CAPTURE_FPS=30

# Phone screen geometry used to turn gaze into degrees.
SCREEN_W_MM=71.5
SCREEN_H_MM=147.0
VIEW_DIST_MM=300

# Paths and server
DB_PATH=data/unnamed.db
DATA_DIR=data
API_BASE=http://localhost:8000
