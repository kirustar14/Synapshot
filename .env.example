# Copy to .env. Every mock switch defaults to ON when the matching key is missing, so the
# whole system runs with this file empty. Nothing here is a secret, every value is blank.
#
# .env is in .gitignore and has never been committed. Keep it that way.
#
# Nothing in Synapshot places a phone call. There is one outbound path: a text with a
# link in it. If you are looking for the switch that used to dial a clinic, it is gone
# along with the code behind it, and a test keeps it gone.

# ---------------------------------------------------------------- the call

# The https URL the texted link points at. An iPhone will not open the camera over plain
# http, so a localhost link cannot work on a phone. Run `make tunnel` for the exact steps.
# No trailing slash.
PUBLIC_URL=

# Only these numbers can ever be texted in live mode. Comma separated, E.164. Put a
# number here only if that person has agreed to be texted.
DEMO_PHONES=

# 1 keeps the uploaded task recordings on disk after the features are taken out of them.
# Off by default: the audio is deleted as soon as it has been measured.
KEEP_AUDIO=0

# ---------------------------------------------------------------- mock switches

# 1 is mock, 0 is real. Leave unset to let the key decide.
#
# MOCK_RIG is demo mode: a call can be driven from a generated session with no phone at
# all, through the same ingest, the same quality gates and the same pipeline a real phone
# goes through. On by default, because it is how the whole flow runs on a laptop.
MOCK_RIG=1
MOCK_LLM=1
MOCK_PHOTON=1
MOCK_TWILIO=1
MOCK_ELEVEN=1
MOCK_CREAO=1

# Reach features on by default.
REACH=1

# Give each signal its own damage level from the regions that drive it, instead of one
# global number. Off by default, see DECISIONS.md.
REGIONAL_LOADINGS=0

# Optional upgrade for twin/surrogate.py. Needs the sbi package.
USE_SBI=0

# 0 uses the real Schaefer atlas, the real HCP connectivity, the real Allen gene map and
# the real fsaverage5 surface. 1 skips every loader that could touch the network.
OFFLINE=0

# ---------------------------------------------------------------- keys

# Gemini, for the document extraction, natural phrasing and the summaries. Setting the
# key flips MOCK_LLM to 0. Called over plain REST with httpx, so there is no extra
# package to install. GOOGLE_API_KEY works in place of GEMINI_API_KEY.
# Valid model ids: gemini-2.5-flash, gemini-2.5-pro, gemini-2.5-flash-lite
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# CREAO agent platform (agent.creao.ai). The three agent care pipeline runs there: triage,
# then briefing and outreach. Build each agent by chatting, click Create Agent, then put its
# id and a capi_ key here. Setting both flips MOCK_CREAO to 0. The key stays on this server
# and never reaches the browser. See docs/CREAO.md for each agent's instructions, its input
# form and the exact setup steps.
CREAO_API_KEY=
# The briefing agent. The pipeline also has a triage agent and an outreach agent. A role with
# no id here runs as a labelled template, so you can add them one at a time.
CREAO_AGENT_ID=
CREAO_TRIAGE_AGENT_ID=
CREAO_OUTREACH_AGENT_ID=
# 1 starts the pipeline by itself when a check-in is scored. Off by default: every run spends credits.
AUTO_AGENT_PIPELINE=0

# ElevenLabs, for the pre-generated voice lines and nothing else. The lines are generated
# once by `make voices` and served as mp3s; no key is needed at call time and no audio is
# ever sent anywhere. ELEVENLABS_VOICE_ID must be a voice your account can actually use:
# a free plan cannot use a library voice through the API, and `make voices` will tell you
# which id to put here if the configured one does not work.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_TTS_MODEL=eleven_multilingual_v2

# Photon iMessage. Setting both flips MOCK_PHOTON to 0. The send itself happens in
# backend/comms/node, so run `make imessage` once to install the two SDKs.
PHOTON_PROJECT_ID=
PHOTON_PROJECT_SECRET=

# Twilio: the SMS fallback for when iMessage cannot deliver. Setting all three flips
# MOCK_TWILIO to 0. A trial account can only reach numbers it has verified first, and a
# message is never labelled iMessage unless a real iMessage transport reported success.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ---------------------------------------------------------------- geometry and paths

# Phone screen and viewing distance, used to turn normalized gaze into degrees.
SCREEN_W_MM=71.5
SCREEN_H_MM=147.0
VIEW_DIST_MM=300

DB_PATH=data/synapshot.db
DATA_DIR=data
API_BASE=http://localhost:8000

# ---------------------------------------------------------------- Tiger Data

# The Tiger Cloud service URI. Copy it from the downloaded service config, including
# ?sslmode=require. With this set, every query goes to Postgres and the telemetry stream
# uses a hypertable, two continuous aggregates and the columnstore. With it empty, sqlite
# is the system of record and the dashboard says so.
DATABASE_URL=

# ---------------------------------------------------------------- clinician login

# 1 requires a session for every clinician route. The default is 0: the web app runs as
# the synthetic admin. Set 1 to enforce accounts and sign in at /login.
AUTH_ENABLED=0

# One click demo sign in. The account is created by make seed.
DEMO_LOGIN=1
DEMO_EMAIL=reyes@synapshot.health
DEMO_PASSWORD=synapshot-demo
SESSION_TTL_H=12

# ---------------------------------------------------------------- Veri

# The decision model. ADAPTIVE_MODE=heuristic runs the deterministic controller with no
# key. Set veri and fill the other two to call the deployment; a miss falls back to the
# static script and the response says which one answered.
ADAPTIVE_MODE=heuristic
VERI_API_KEY=
VERI_DEPLOYMENT_ID=
VERI_MODEL=synapshot-adaptive
VERI_API_URL=https://api.veri.studio

# ---------------------------------------------------------------- Sentry

# Errors, tracing, profiling and logs for the backend. Blank keeps Sentry off. Call
# tokens are masked before anything is sent. The frontend DSN goes in web/.env.local as
# VITE_SENTRY_DSN, because Vite only reads env files from web/.
SENTRY_DSN=
SENTRY_ENV=

